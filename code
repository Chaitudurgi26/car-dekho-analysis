    Load car data from a CSV file.
    
    Args:
        file_path (str): Path to the CSV file containing car data.
        
    Returns:
        pd.DataFrame: DataFrame containing the loaded car data.
    """
    # Fix the raw string literal syntax and use forward slashes for path compatibility
    file_path_fixed = r"C:\Users\krish\Downloads\car_Dekho_DA.csv"
    
    # Load the data
    car_data = pd.read_csv(file_path_fixed)
    
    return car_data

